{
  "$schema": "https://raw.githubusercontent.com/nozomi-koborinai/contextlint/main/schema.json",
  "include": [
    ".kiro/**/*.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/**/*.md",
    "README.md"
  ],
  "rules": [
    {
      "rule": "tbl002"
    },
    {
      "options": {
        "files": [
          "AGENTS.md",
          "CONTRIBUTING.md",
          "docs/comprehensive.md",
          "docs/quickstart.md",
          "README.md"
        ]
      },
      "rule": "str001"
    },
    {
      "rule": "ref001"
    },
    {
      "rule": "ref005"
    },
    {
      "rule": "ref006"
    },
    {
      "options": {
        "files": ".kiro/specs/**/tasks.md"
      },
      "rule": "chk001"
    },
    {
      "rule": "ctx001"
    },
    {
      "rule": "grp002"
    }
  ]
}
