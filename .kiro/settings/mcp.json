{
  "mcpServers": {
    "kirograph": {
      "command": "kirograph",
      "args": [
        "serve",
        "--mcp"
      ],
      "disabled": false,
      "autoApprove": [
        "kirograph_search",
        "kirograph_context",
        "kirograph_callers",
        "kirograph_callees",
        "kirograph_impact",
        "kirograph_node",
        "kirograph_status",
        "kirograph_files",
        "kirograph_dead_code",
        "kirograph_circular_deps",
        "kirograph_path",
        "kirograph_type_hierarchy"
      ]
    },
    "aws-agent-toolkit": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-west-2"
      ],
      "env": {
        "AWS_PROFILE": "msa-ro"
      }
    }
  }
}
